# Generated by Cargo
# will have compiled files and executables
/target/
**/target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Cargo build lockfile — committed for binaries, ignored for libraries.
# derrick ships a binary (derrick-cli), so we *do* commit Cargo.lock.
# (Intentionally not gitignored here.)

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Coverage
*.profraw
*.profdata
/lcov.info
/coverage/

# derrick runtime state (per-repo, never committed)
.derrick/runs/
.derrick/state.json
.derrick/locks/
.derrick/foreman.pid
.derrick/derrick.db
.derrick/derrick.db-shm
.derrick/derrick.db-wal
.derrick/worktrees/

# Local secrets (never committed)
.env
.env.local
~/.derrick/credentials.yaml
