version: 1
site:
  name: {{site_name}}
  prefix: {{prefix}}
models:
  claude-opus:
    provider: claude
    model: claude-opus-4-8
  claude-sonnet:
    provider: claude
    model: claude-sonnet-4-6
  claude-haiku:
    provider: claude
    model: claude-haiku-4-5
  codex-gpt5:
    provider: codex
    model: gpt-5.5
  copilot:
    provider: copilot
    # `auto` (D67): the foreman picks the best copilot model per ticket by
    # complexity. Pin a specific id here to override.
    model: auto
roles:
  proposer: claude-opus
  drafter: claude-sonnet
  reviewer: codex-gpt5
  executor: copilot
  summariser: claude-haiku
tools:
  specify:
    provider: native
  speckit:
    enabled: true
    version: ">=0.4.0"
  assay:
    enabled: true
    role: reviewer
    reviewers: [reviewer]
    rounds: 1
    strict: false
    on_split: reject
  substrate:
    backend: native
    mode: {{mode}}
  copilot:
    enabled: false
    agent_identity: derrick-hand
  git:
    stacking:
      backend: none
  roughneck:
    enabled: true
    level: full      # lite | full | ultra
    compress_memory: false
pipeline:
  - id: specify
  - id: clarify
    runner: derrick
    skippable: true
  - id: plan
  - id: assay
    runner: derrick
    inputs: ["{{feature_dir}}/spec.md", "{{feature_dir}}/plan.md"]
    rounds: "{{tools.assay.rounds}}"
    on_reject: halt
    skippable: true
  - id: tasks
guardrails:
  constitution_path: .specify/memory/constitution.md
  forbid_paths: []
  required_labels: []
parallelism:
  batch_max: 8
  step_max: 4
  assay_max: 2
state:
  dir: .derrick
  log_runs: true
  worktree_root: .derrick/worktrees
